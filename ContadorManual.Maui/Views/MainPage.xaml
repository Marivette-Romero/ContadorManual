<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContadorManual.Maui.Views.MainPage"
             Title="Contador Manual">
    
    <!-- Para comentar en el xml: ctrl+k+C  -->
    <!-- edicion del cuerpo: -->
    <StackLayout 
        Orientation="Vertical"     
        Spacing="15" 
        Margin="12"
        Padding="16">
        
        <!-- Horizontal options no funciona para un stacklayout de orientacion horizontal, 
        aplica Vertical Options -->
        <Label 
            Text="Conteo:" 
            HorizontalOptions="Fill"
            FontSize="Medium"
        />

        <Border 
            Stroke="Gray"
            StrokeThickness="2">
           
            <Label 
                Text="10" 
                Padding="0,24"
                HorizontalOptions="Center"
                FontSize="Large"
                FontAttributes="Bold"
                x:Name="ConteoLabel"
            
            />
            
        </Border>

        <!-- se puede poner otro stacklayout dentro de uno existente: -->
        
        <StackLayout 
           Orientation="Horizontal" 
           HorizontalOptions="Center"
           Spacing="24"
           Margin="0,24,0,0">
           
           <Button
            Text="Contar"
            Clicked="OnContarButtonClicked" 
           />

           <Button 
             Text="Reiniciar"
             Clicked="OnReiniciarButtonClicked"
           />

       </StackLayout>
       
        
         
    </StackLayout>


</ContentPage>