<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContadorManual.Maui.Views.MainPage"
             Title="Contador Manual">

    <!--22/09/2026: Actualizacion a enlace de datos a un objeto de datos.-->
    
    <!-- Para comentar en el xml: ctrl+k+C  -->
    <!-- edicion del cuerpo: -->
    <!-- Para ahorrar codigo cambiamos al StackLayout por VerticalStackLayout -->
    <VerticalStackLayout      
        Spacing="15" 
        Margin="12"
        Padding="16">
        
      <!-- Horizontal options no funciona para un stacklayout de orientacion horizontal, aplica Vertical Options -->
        <Label 
            Text="Conteo:" 
            HorizontalOptions="Fill"
            FontSize="Medium"
        />

        <Border 
            Stroke="Gray"
            StrokeThickness="2">

            <!--Retiramos esto x:Name="ConteoLabel" por el enlace de datos-->
            <Label 
                Text="{Binding Path=Conteo}" 
                Padding="0,24"
                HorizontalOptions="Center"
                FontSize="Large"
                FontAttributes="Bold"
            
            />
            
        </Border>
        
        <!--23/09/2026: Actualizacion-->

        <HorizontalStackLayout Spacing="8">
            <Label 
                Text="El Conteo incrementará por:"
                VerticalOptions="Center"
            />
            <!--...............Enlace de datos entre elementos xml.............-->
            <Entry
                Text="{Binding Source= {x:Reference IncrementoStepper}, Path=Value}"
                IsReadOnly="True"
            />
            <Stepper
                Minimum="1"
                Maximum="20"
                Value="{Binding Path=Incremento}"
                x:Name="IncrementoStepper"  
            />
            <!-- Cambiamos esto :ValueChanged="OnIncrementoStepperValueChanged por:Value="{Binding Path=Incremento}" "-->
            
            <!--................................................................-->

        </HorizontalStackLayout>

        <!-- se puede poner otro stacklayout dentro de uno existente: -->

        <HorizontalStackLayout 
           HorizontalOptions="Center"
           Spacing="24"
           Margin="0,24,0,0">

            <Button
            Text="Contar"
            Clicked="OnContarButtonClicked" 
           />

            <Button 
             Text="Reiniciar"
             Clicked="OnReiniciarButtonClicked"
           />

        </HorizontalStackLayout>

    </VerticalStackLayout>


</ContentPage>